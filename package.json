{
  "name": "alphame",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "build:api": "npm --workspace apps/api run build",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "dev:miniapp": "npm --workspace apps/miniapp run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build": "npm run build:api && npm run build:miniapp && npm run build:admin",
    "build:miniapp": "npm --workspace apps/miniapp run build",
    "build:admin": "npm --workspace apps/admin run build",
    "typecheck": "npm run typecheck:api && npm run typecheck:miniapp && npm run typecheck:admin",
    "typecheck:miniapp": "npm --workspace apps/miniapp run typecheck",
    "typecheck:admin": "npm --workspace apps/admin run typecheck"
  }
}
