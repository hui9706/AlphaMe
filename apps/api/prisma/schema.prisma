generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LedgerType {
  INITIAL_GRANT
  RESERVATION
  GENERATION_CHARGE
  REFUND
  ADMIN_ADJUSTMENT
}

enum ApiKeyStatus {
  ACTIVE
  PAUSED
  EXHAUSTED
  INVALID
}

model User {
  id          String       @id @default(cuid())
  zaloOpenId  String       @unique
  displayName String?
  avatarUrl   String?
  language    String       @default("vi")
  coinAccount CoinAccount?
  generations Generation[]
  assets      Asset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("operator")
  enabled      Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CoinAccount {
  id        String       @id @default(cuid())
  userId    String       @unique
  available Int          @default(0)
  frozen    Int          @default(0)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    CoinLedger[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model CoinLedger {
  id             String      @id @default(cuid())
  accountId      String
  type           LedgerType
  amount         Int
  availableAfter Int
  frozenAfter    Int
  idempotencyKey String      @unique
  generationId   String?
  note           String?
  account        CoinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  generation     Generation? @relation(fields: [generationId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([accountId, createdAt])
}

model Template {
  id          String       @id @default(cuid())
  slug        String       @unique
  nameVi      String
  nameZh      String
  prompt      String
  coverUrl    String?
  coinCost    Int          @default(10)
  enabled     Boolean      @default(true)
  generations Generation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Generation {
  id             String           @id @default(cuid())
  idempotencyKey String           @unique
  userId         String
  templateId     String
  status         GenerationStatus @default(QUEUED)
  sourceAssetUrl String
  resultAssetUrl String?
  coinCost       Int
  errorCode      String?
  errorMessage   String?
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  template       Template         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  ledger         CoinLedger[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Asset {
  id         String   @id @default(cuid())
  userId     String?
  kind       String
  storageKey String   @unique
  publicUrl  String
  mimeType   String
  byteSize   Int
  expiresAt  DateTime?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([expiresAt])
}

model ApiKey {
  id             String       @id @default(cuid())
  label          String
  encryptedValue String
  priority       Int          @default(100)
  status         ApiKeyStatus @default(ACTIVE)
  failureCount   Int          @default(0)
  lastUsedAt     DateTime?
  pausedUntil    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, priority])
}
