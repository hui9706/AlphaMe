generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LedgerType {
  INITIAL_GRANT
  RESERVATION
  GENERATION_CHARGE
  REFUND
  ADMIN_ADJUSTMENT
  REWARD
  REWARD_REVERSAL
}

enum RewardType {
  DAILY_CHECK_IN
  SHARE_OPEN
  PLAZA_LIKE
  ADMIN_ADJUSTMENT
  ADMIN_REVERSAL
}

enum RewardStatus {
  GRANTED
  REVOKED
  BLOCKED
}

enum RiskStatus {
  OPEN
  REVIEWED
  CLEARED
  BLOCKED
}

enum ApiKeyStatus {
  ACTIVE
  PAUSED
  EXHAUSTED
  INVALID
}

model User {
  id          String       @id @default(cuid())
  zaloOpenId  String?      @unique
  username    String?      @unique
  passwordHash String?
  displayName String?
  avatarUrl   String?
  language    String       @default("vi")
  isAdmin     Boolean      @default(false)
  coinAccount CoinAccount?
  generations Generation[]
  assets      Asset[]
  dailyCheckIns DailyCheckIn[]
  plazaWorks  PlazaWork[]
  plazaLikes  PlazaLike[]
  sharesSent  ShareAttribution[] @relation("ShareSender")
  sharesOpened ShareAttribution[] @relation("ShareFriend")
  rewards     RewardRecord[]
  riskEvents  RewardRiskEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("operator")
  enabled      Boolean   @default(true)
  lastLoginAt  DateTime?
  coinLedgerActions CoinLedger[] @relation("CoinLedgerAdmin")
  rewardReversals RewardRecord[] @relation("RewardRevokedBy")
  riskReviews RewardRiskEvent[] @relation("RiskReviewedBy")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CoinAccount {
  id        String       @id @default(cuid())
  userId    String       @unique
  available Int          @default(0)
  frozen    Int          @default(0)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    CoinLedger[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model CoinLedger {
  id             String      @id @default(cuid())
  accountId      String
  type           LedgerType
  amount         Int
  availableAfter Int
  frozenAfter    Int
  idempotencyKey String      @unique
  generationId   String?
  adminUserId    String?
  rewardRecordId String?     @unique
  note           String?
  account        CoinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  generation     Generation? @relation(fields: [generationId], references: [id])
  adminUser      AdminUser? @relation("CoinLedgerAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  rewardRecord   RewardRecord? @relation(fields: [rewardRecordId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([accountId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([rewardRecordId])
}

model DailyCheckIn {
  id          String   @id @default(cuid())
  userId      String
  checkInDate DateTime @db.Date
  reward      RewardRecord?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, checkInDate])
  @@index([checkInDate])
}

model PlazaWork {
  id          String      @id @default(cuid())
  generationId String     @unique
  userId      String
  publishedAt DateTime    @default(now())
  generation  Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      PlazaLike[]
  rewards    RewardRecord[]

  @@index([userId, publishedAt])
  @@index([publishedAt])
}

model PlazaLike {
  id          String   @id @default(cuid())
  plazaWorkId String
  userId      String
  plazaWork   PlazaWork @relation(fields: [plazaWorkId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      RewardRecord?
  createdAt   DateTime @default(now())

  @@unique([plazaWorkId, userId])
  @@index([userId, createdAt])
}

model ShareAttribution {
  id          String   @id @default(cuid())
  shareToken  String   @unique
  generationId String
  sharerId    String
  friendId    String?
  openedAt    DateTime?
  reward      RewardRecord?
  generation  Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  sharer      User     @relation("ShareSender", fields: [sharerId], references: [id], onDelete: Cascade)
  friend      User?    @relation("ShareFriend", fields: [friendId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([generationId, sharerId])
  @@index([friendId, openedAt])
  @@unique([generationId, sharerId, friendId])
}

model RewardRecord {
  id             String       @id @default(cuid())
  userId         String
  type           RewardType
  status         RewardStatus @default(GRANTED)
  amount         Int
  idempotencyKey String       @unique
  sourceType     String
  sourceId       String
  note           String?
  revokedAt      DateTime?
  revokedByAdminId String?
  revokeReason   String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger         CoinLedger?
  dailyCheckIn   DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: SetNull)
  dailyCheckInId String?      @unique
  plazaLike      PlazaLike?   @relation(fields: [plazaLikeId], references: [id], onDelete: SetNull)
  plazaLikeId    String?      @unique
  plazaWork      PlazaWork?   @relation(fields: [plazaWorkId], references: [id], onDelete: SetNull)
  plazaWorkId    String?
  share          ShareAttribution? @relation(fields: [shareId], references: [id], onDelete: SetNull)
  shareId        String?      @unique
  revokedByAdmin AdminUser?   @relation("RewardRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([type, status, createdAt])
  @@index([sourceType, sourceId])
  @@index([plazaWorkId])
}

model RewardRiskEvent {
  id            String     @id @default(cuid())
  userId        String
  type          String
  status        RiskStatus @default(OPEN)
  score         Int        @default(0)
  sourceType    String?
  sourceId      String?
  detail        String?
  reviewedByAdminId String?
  reviewedAt    DateTime?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin AdminUser? @relation("RiskReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Template {
  id          String       @id @default(cuid())
  slug        String       @unique
  nameVi      String
  nameZh      String
  prompt      String   @db.Text
  coverUrl    String?
  coinCost    Int          @default(10)
  sortOrder   Int          @default(0)
  enabled     Boolean      @default(true)
  generations Generation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Generation {
  id             String           @id @default(cuid())
  idempotencyKey String           @unique
  userId         String
  templateId     String
  status         GenerationStatus @default(QUEUED)
  sourceAssetUrl String
  resultAssetUrl String?
  coinCost       Int
  errorCode      String?
  errorMessage   String?
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  template       Template         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  ledger         CoinLedger[]
  plazaWork      PlazaWork?
  shares         ShareAttribution[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Asset {
  id         String   @id @default(cuid())
  userId     String?
  kind       String
  storageKey String   @unique
  storageProvider String @default("local")
  publicUrl  String
  mimeType   String
  byteSize   Int
  expiresAt  DateTime?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([expiresAt])
}

model StorageConfig {
  id                  String   @id
  provider            String   @default("local")
  enabled             Boolean  @default(false)
  qiniuAccessKey      String?
  qiniuSecretKey      String?
  qiniuBucket         String?
  qiniuRegion         String?
  qiniuDomain         String?
  qiniuPrivate        Boolean  @default(true)
  qiniuUrlTtlSeconds  Int      @default(2592000)
  fallbackLocal       Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model VolcengineConfig {
  id         String   @id
  accessKey  String?
  secretKey  String?
  region     String   @default("cn-beijing")
  updatedAt  DateTime @updatedAt
}

model ApiKey {
  id             String       @id @default(cuid())
  label          String
  encryptedValue String
  priority       Int          @default(100)
  status         ApiKeyStatus @default(ACTIVE)
  failureCount   Int          @default(0)
  lastUsedAt     DateTime?
  pausedUntil    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, priority])
}
